# MongoDB Atlas connection string (include the /loanlens database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loanlens?retryWrites=true&w=majority

# Anthropic API key (console.anthropic.com) — used for both document
# extraction (unless EXTRACTION_PROVIDER=groq) and the RAG assistant chat.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq API key (console.groq.com) — free developer tier, no card required.
# Only used for document extraction, and only when EXTRACTION_PROVIDER=groq
# below. The RAG assistant chat always uses Claude regardless of this
# setting (rag.js has no Groq path).
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# Which vision provider runs document classification + field extraction:
# "anthropic" (default, Claude) or "groq" (free, no ANTHROPIC_API_KEY
# needed for extraction — useful while a Claude key is still pending
# approval). See services/extractionProvider.js.
EXTRACTION_PROVIDER=anthropic

# Set to "true" to bypass real AI entirely — both extraction (regardless of
# EXTRACTION_PROVIDER above) and the assistant chat return canned/
# deterministic results instead of calling any API. For testing everything
# else (verification, live-exception flow, status transitions) when neither
# key has credit/access yet, or just to develop without spending API calls.
# Leave unset/false for real AI behavior.
MOCK_AI=false

# Where uploaded files' bytes live (see services/storage.js):
#   mongo (default) — inside MongoDB, exactly as before
#   r2              — a PRIVATE Cloudflare R2 bucket; MongoDB keeps only metadata.
# If r2 is selected but unreachable or incomplete, uploads fall back to MongoDB
# instead of failing. Verify after deploying with
#   /admin/storage-check?secret=<SETUP_SECRET>
STORAGE_PROVIDER=mongo
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loanlens-documents-dev

# JWT signing secret — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Guards the one-time /admin/seed and /admin/ingest endpoints
SETUP_SECRET=change-me-too

PORT=4000
