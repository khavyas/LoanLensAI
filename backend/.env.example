# MongoDB Atlas connection string (include the /loanlens database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loanlens?retryWrites=true&w=majority

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to "true" to bypass Claude entirely (extraction + assistant both
# return canned/deterministic results instead of calling the API) — for
# testing everything else (verification, live-exception flow, status
# transitions) when ANTHROPIC_API_KEY has no credit, or just to develop
# without spending API credits. Leave unset/false for real AI behavior.
MOCK_AI=false

# JWT signing secret — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Guards the one-time /admin/seed and /admin/ingest endpoints
SETUP_SECRET=change-me-too

PORT=4000
