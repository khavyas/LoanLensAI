# MongoDB Atlas connection string (include the /loanlens database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loanlens?retryWrites=true&w=majority

# Anthropic API key (console.anthropic.com) — used for extraction and when
# CHAT_PROVIDER=anthropic. Existing default behavior is preserved.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq API key (console.groq.com) â€” free-plan use is subject to account quotas.
# Used when EXTRACTION_PROVIDER=groq and/or CHAT_PROVIDER=groq.
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# Which vision provider runs document classification + field extraction:
# "anthropic" (default, Claude) or "groq" (free, no ANTHROPIC_API_KEY
# needed for extraction — useful while a Claude key is still pending
# approval). See services/extractionProvider.js.
EXTRACTION_PROVIDER=anthropic

# Assistant provider. Defaults to Anthropic to preserve current behavior.
# Set to "groq" to use Groq for Assistant answers as well.
CHAT_PROVIDER=anthropic

# Set to "true" to bypass real AI entirely — both extraction (regardless of
# EXTRACTION_PROVIDER above) and the assistant chat return canned/
# deterministic results instead of calling any API. For testing everything
# else (verification, live-exception flow, status transitions) when neither
# key has credit/access yet, or just to develop without spending API calls.
# Leave unset/false for real AI behavior.
MOCK_AI=false

# Optional Ollama + Chroma RAG mode. Set CHAT_PROVIDER=ollama to enable.
# For Chroma Cloud, use https://api.trychroma.com, your tenant/database IDs,
# and keep the API key in the ignored .env file. Never commit that key.
# Localhost Chroma is also supported for development.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=gemma4
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_MS=120000
CHROMA_BASE_URL=http://localhost:8000
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=loan-knowledge
CHROMA_TIMEOUT_MS=30000
RAG_TOP_K=5
# Initial distance cutoff for Chroma's default L2 space; tune against QA data. It is not a probability.
RAG_MAX_DISTANCE=1.0
RAG_EMBED_BATCH_SIZE=32
RAG_MAX_QUESTION_CHARS=4000

# Where uploaded files' bytes live (see services/storage.js):
#   mongo (default) — inside MongoDB, exactly as before
#   r2              — a PRIVATE Cloudflare R2 bucket; MongoDB keeps only metadata.
# If r2 is selected but unreachable or incomplete, uploads fall back to MongoDB
# instead of failing. Verify after deploying with
#   /admin/storage-check?secret=<SETUP_SECRET>
STORAGE_PROVIDER=mongo
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loanlens-documents-dev

# JWT signing secret — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Guards the one-time /admin/seed and /admin/ingest endpoints
SETUP_SECRET=change-me-too

PORT=4000
